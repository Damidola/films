comment-id-3654563"},{"id":"3410486","depth":0,"parentId":null,"replyTo":null,"author":"ruslankorzhan","text":"Не очень","publishedText":"25 декабря 2022 16:26","likes":5,"spoiler":false,"url":"https://hdrezka.me/films/drama/33512-obman-2019.html#comment-id-3410486"},{"id":"3348794","depth":0,"parentId":null,"replyTo":null,"author":"Vova_kras","text":"администрация добавте будь ласка озвучку оригінал-субтитри","publishedText":"21 ноября 2022 10:59","likes":0,"spoiler":false,"url":"https://hdrezka.me/films/drama/33512-obman-2019.html#comment-id-3348794"},{"id":"3348829","depth":1,"parentId":"3348794","replyTo":"Vova_kras","author":"Администрация","text":"Мы не добавляем оригинал без русских субтитров, а они для фильма отсутствуют.","publishedText":"21 ноября 2022 11:31","likes":2,"spoiler":false,"url":"https://hdrezka.me/films/drama/33512-obman-2019.html#comment-id-3348829"},{"id":"3639503","depth":2,"parentId":"3348829","replyTo":"Администрация","author":"ellliot407","text":"Чому ні? Тут же не супер науковий фільм, можна і без них обійтись.","publishedText":"8 апреля 2023 09:57","likes":1,"spoiler":false,"url":"https://hdrezka.me/films/drama/33512-obman-2019.html#comment-id-3639503"},{"id":"3341882","depth":0,"parentId":null,"replyTo":null,"author":"Rashitovna","text":"Какая дурацкая визжащая озвучка главной героини.","publishedText":"17 ноября 2022 23:51","likes":4,"spoiler":false,"url":"https://hdrezka.me/films/drama/33512-obman-2019.html#comment-id-3341882"},{"id":"3331907","depth":0,"parentId":null,"replyTo":null,"author":"ВитлийСокол","text":"бред сивой кобылы","publishedText":"12 ноября 2022 12:47","likes":5,"spoiler":false,"url":"https://hdrezka.me/films/drama/33512-obman-2019.html#comment-id-3331907"}],"total":null,"order":"page","fetchedAt":"2026-10-20T19:14:16.108Z","source":{"name":"HDrezka","host":"hdrezka.me","url":"https://hdrezka.me/films/drama/33512-obman-2019.html"},"allAvailable":false}
